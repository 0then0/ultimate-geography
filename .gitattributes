# Keep editable sources consistent on every supported development platform.
* text=auto eol=lf
*.csv text eol=lf
*.svg text eol=lf

# Preserve third-party media, workbook and package bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.xlsx binary
*.apkg binary
*.zip binary

# These third-party assets are hash-bound in media-attribution.csv.
# Preserve SVG and experimental JS/CSS bytes as well as raster images.
src/media/** -text

# Keep original whitespace in these hash-bound third-party flag assets.
src/media/flags/ug-flag-british_virgin_islands.svg whitespace=-blank-at-eol
src/media/flags/ug-flag-gibraltar.svg whitespace=-blank-at-eol
src/media/flags/ug-flag-guernsey.svg whitespace=-blank-at-eol
src/media/flags/ug-flag-isle_of_man.svg whitespace=-blank-at-eol
